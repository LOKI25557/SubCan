# ==============================================================================
# SubCan Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your local values.
# DO NOT COMMIT .env TO GIT — it is in .gitignore.
# NEVER put real secrets in this file. This is a template with placeholders only.
#
# GOOGLE OAUTH NOTE:
#   The previously shared Google client secret is considered COMPROMISED.
#   Do NOT reuse it. Rotate the secret in Google Cloud Console and paste the
#   new value into your local .env ONLY — never in this file.
# ==============================================================================

# Application settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Database (SQLite path relative to repo root, or absolute)
DATABASE_URL=sqlite:///./reports/subcan.db

# Agent orchestration & decision rules
DECISION_INACTIVITY_THRESHOLD_DAYS=90
REQUIRE_EXPLICIT_APPROVAL=True

# Mock site connector endpoints (Chinmay's module)
MOCK_SITE_BASE_URL=https://mock.streaming.test
MOCK_SITE_TIMEOUT_SECONDS=5.0

# Google OAuth 2.0 — REQUIRED for Gmail integration (Phase 3+)
# Obtain from: https://console.cloud.google.com/apis/credentials
# Rotate the secret if it was previously shared or committed.
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ROTATE_YOUR_SECRET_DO_NOT_REUSE_OLD_VALUE
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/email/oauth/callback

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# ==============================================================================
# Google Cloud Console Setup Checklist
# ==============================================================================
# 1. Create a project at https://console.cloud.google.com
# 2. Enable the Gmail API: APIs & Services > Library > Gmail API
# 3. Enable the People API (for user info): People API
# 4. Configure OAuth consent screen:
#    - User type: External (or Internal for Workspace orgs)
#    - App name: SubCan
#    - Scopes: .../auth/gmail.readonly, openid, .../auth/userinfo.email
#    - Test users: add your Gmail address while in Testing mode
# 5. Create OAuth 2.0 Client ID:
#    - Application type: Web application
#    - Authorized redirect URI: http://127.0.0.1:8000/api/email/oauth/callback
# 6. Download credentials and paste ONLY client_id and client_secret into .env
# 7. NEVER paste credentials into this .env.example file
# ==============================================================================
