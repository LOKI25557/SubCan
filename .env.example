# ==============================================================================
# SubCan Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure local values as needed.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE CREDENTIALS TO SOURCE CONTROL.

# Application settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# SQLite Database Persistence
DATABASE_URL=sqlite:///./reports/subcan.db

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Configuration (Email Discovery Subsystem)
# ------------------------------------------------------------------------------
# SETUP INSTRUCTIONS:
# 1. Open Google Cloud Console: https://console.cloud.google.com/
# 2. Create or select a project (e.g., 'SubCan-Dev').
# 3. Enable the Gmail API: APIs & Services -> Library -> Search 'Gmail API' -> Enable.
# 4. Configure OAuth Consent Screen: APIs & Services -> OAuth consent screen
#    - User Type: External
#    - App Name: SubCan
#    - Scopes: Add 'https://www.googleapis.com/auth/gmail.readonly'
#    - Test Users: Add your personal or testing Gmail address.
# 5. Create Credentials: APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#    - Application type: Web application
#    - Name: SubCan Web Client
#    - Authorized redirect URIs: http://127.0.0.1:8000/api/email/oauth/callback
# 6. Copy the Client ID and Client Secret into your local .env file below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/email/oauth/callback

# NOTE: If GOOGLE_CLIENT_ID or GOOGLE_CLIENT_SECRET are blank or omitted,
# SubCan automatically operates in Safe Demo Fallback mode using realistic
# synthetic billing emails without connecting to Google Cloud.

# Backend Deployed Production URL (Render)
BACKEND_URL=https://subcan.onrender.com

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=https://subcan.onrender.com,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
